---
Checks: >-
  -*,
  clang-analyzer-core.*,clang-analyzer-cplusplus.*,clang-analyzer-deadcode.*,
  bugprone-dangling-handle,bugprone-inaccurate-erase,bugprone-infinite-loop,
  bugprone-multiple-statement-macro,bugprone-move-forwarding-reference,
  bugprone-sizeof-expression,bugprone-suspicious-semicolon,
  bugprone-unused-raii,bugprone-use-after-move
WarningsAsErrors: ''
HeaderFilterRegex: '(^|[/\\])(core[/\\](include|src|tests|sandbox)|editor[/\\](include|src|tests))[/\\]'
ExcludeHeaderFilterRegex: '(^|[/\\])(extlibs|ext)[/\\]'
SystemHeaders: false
FormatStyle: none
