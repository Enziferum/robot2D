PROJECT_NAME = "robot2D Core"
PROJECT_NUMBER = "@CMAKE_PROJECT_VERSION@"
OUTPUT_DIRECTORY = docs/core
INPUT = "@RB2D_DOC_SOURCE@/core/include/robot2D/Core/Vector2.hpp" "@RB2D_DOC_SOURCE@/core/include/robot2D/Core/Vector3.hpp" "@RB2D_DOC_SOURCE@/core/include/robot2D/Core/Time.hpp" "@RB2D_DOC_SOURCE@/core/include/robot2D/Core/Clock.hpp" "@RB2D_DOC_SOURCE@/core/include/robot2D/Core/FileInputStream.hpp" "@RB2D_DOC_SOURCE@/core/include/robot2D/Util" "@RB2D_DOC_SOURCE@/docs/core-api.md" "@RB2D_DOC_SOURCE@/core/include/robot2D/Core/Message.hpp" "@RB2D_DOC_SOURCE@/core/include/robot2D/Core/MessageBus.hpp"
USE_MDFILE_AS_MAINPAGE = "@RB2D_DOC_SOURCE@/docs/core-api.md"
RECURSIVE = YES
GENERATE_HTML = YES
GENERATE_LATEX = NO
EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
WARN_IF_UNDOCUMENTED = NO
WARN_IF_DOC_ERROR = YES
WARN_AS_ERROR = YES
PREDEFINED = ROBOT2D_EXPORT_API=
HAVE_DOT = NO
QUIET = YES
