#!/bin/sh
# Git for Windows also supplies this POSIX shell.
set -eu
if command -v python3 >/dev/null 2>&1; then
    exec python3 scripts/check_commit_message.py "$1"
elif command -v python >/dev/null 2>&1; then
    exec python scripts/check_commit_message.py "$1"
else
    echo "commit-msg: Python 3 is required. Install Python and retry." >&2
    exit 1
fi
