if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()
# Build-tree player template. Game assets/launch manifest are supplied separately.
get_filename_component(destination "${PLAYER}" DIRECTORY)
get_filename_component(compiler_bin "${COMPILER}" DIRECTORY)
file(MAKE_DIRECTORY "${destination}/runtime/mono/lib/mono")
file(COPY "${CORE}" DESTINATION "${destination}/runtime")
foreach(directory IN ITEMS 4.5 gac)
    if(NOT IS_DIRECTORY "${MONO_LIB}/mono/${directory}")
        message(FATAL_ERROR "Mono runtime directory missing: ${MONO_LIB}/mono/${directory}")
    endif()
    file(COPY "${MONO_LIB}/mono/${directory}" DESTINATION "${destination}/runtime/mono/lib/mono")
endforeach()
if(NOT IS_DIRECTORY "${MONO_ETC}/mono")
    message(FATAL_ERROR "Mono configuration directory missing: ${MONO_ETC}/mono")
endif()
file(COPY "${MONO_ETC}/mono" DESTINATION "${destination}/runtime/mono/etc")
file(GLOB mono_helpers "${MONO_LIB}/*MonoPosixHelper*.so*" "${MONO_LIB}/*mono-native*.so*"
    "${MONO_BIN}/*MonoPosixHelper*.dll" "${MONO_LIB}/*MonoPosixHelper*.dll")
if(mono_helpers)
    file(COPY ${mono_helpers} DESTINATION "${destination}/runtime/mono/lib" FOLLOW_SYMLINK_CHAIN)
endif()
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${OBJDUMP}")
if(WIN32)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
else()
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM linux+elf)
endif()
file(GET_RUNTIME_DEPENDENCIES EXECUTABLES "${PLAYER}" LIBRARIES ${mono_helpers}
    DIRECTORIES "${compiler_bin}" "${MONO_BIN}"
    PRE_EXCLUDE_REGEXES "^api-ms-" "^ext-ms-"
    RESOLVED_DEPENDENCIES_VAR dependencies UNRESOLVED_DEPENDENCIES_VAR missing
    CONFLICTING_DEPENDENCIES_PREFIX collision)
foreach(name IN LISTS collision_FILENAMES)
    set(hash "")
    foreach(candidate IN LISTS collision_${name})
        file(SHA256 "${candidate}" candidate_hash)
        if(hash AND NOT hash STREQUAL candidate_hash)
            message(FATAL_ERROR "Conflicting player dependencies for ${name}: ${collision_${name}}")
        endif()
        set(hash "${candidate_hash}")
    endforeach()
    list(GET collision_${name} 0 selected)
    list(APPEND dependencies "${selected}")
endforeach()
if(missing)
    message(FATAL_ERROR "Unresolved player runtime dependencies: ${missing}")
endif()
foreach(dependency IN LISTS dependencies)
    string(TOLOWER "${dependency}" lower)
    get_filename_component(name "${lower}" NAME)
    if(WIN32 AND lower MATCHES "[/\\]windows[/\\]" AND NOT name MATCHES "^(vcruntime|msvcp|concrt)")
        continue()
    endif()
    if(NOT WIN32 AND lower MATCHES "/(ld-linux[^/]*|lib(c|m|pthread|rt|dl)\\.so[^/]*)$")
        continue()
    endif()
    file(COPY "${dependency}" DESTINATION "${destination}" FOLLOW_SYMLINK_CHAIN)
endforeach()
