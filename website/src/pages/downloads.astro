---
import SiteLayout from '../layouts/SiteLayout.astro';
import { path, repo, developmentVersion, date } from '../lib/site';
import { snapshot } from '../lib/releases';
const latest = snapshot.releases[0];
---

<SiteLayout title="Get robot2D">
  <section class="page-intro wrap">
    <p class="eyebrow">Get robot2D</p>
    <h1>
      A small engine.
      <br />
      <em>Start exploring.</em>
    </h1>
    <p class="lede">
      The current development version is {developmentVersion}. For the latest
      work, build the dev branch from source.
    </p>
  </section>
  <section class="wrap download-panel">
    <div>
      <span class="pill">Current development</span>
      <h2>{developmentVersion}</h2>
      <p>
        For developers who want to explore the engine and help shape the next
        release.
      </p>
      <div class="actions">
        <a class="button" href={path('docs/getting-started/')}>
          Build from source →
        </a>
        <a class="text-link" href={`${repo}/tree/dev`}>
          Browse dev ↗
        </a>
      </div>
    </div>
    <dl class="facts">
      <div>
        <dt>Development platforms</dt>
        <dd>Windows and Linux source builds</dd>
      </div>
      <div>
        <dt>Graphics</dt>
        <dd>OpenGL 4.5-capable GPU and driver</dd>
      </div>
      <div>
        <dt>Toolchain</dt>
        <dd>C++17 · CMake 3.21+ · Mono / MSBuild</dd>
      </div>
      <div>
        <dt>Binary distribution</dt>
        <dd>No current installer published in the release snapshot.</dd>
      </div>
    </dl>
  </section>
  <section class="section wrap split">
    <div>
      <p class="eyebrow">Release archive</p>
      <h2>Earlier chapters.</h2>
    </div>
    <div>
      <p class="lede">
        The most recent published release in our snapshot is{' '}
        <strong>{latest.tag}</strong>, from {date(latest.publishedAt)}. It
        predates the editor shown on this website.
      </p>
      <p>
        That release has{' '}
        {latest.assets.length === 0
          ? 'no attached binary downloads'
          : `${latest.assets.length} attached files`}
        . GitHub provides source archives on its release page.
      </p>
      <a class="text-link" href={path('releases/')}>
        Browse release history →
      </a>
      <p class="fine">
        Release snapshot checked {date(snapshot.fetchedAt)}.{' '}
        <a href={`${repo}/releases`}>Check GitHub for newer releases ↗</a>
      </p>
    </div>
  </section>
</SiteLayout>
