---
import SiteLayout from '../layouts/SiteLayout.astro';
import { path, repo, developmentVersion, date } from '../lib/site';
import { snapshot } from '../lib/releases';
const latest = snapshot.releases.find((release) => !release.prerelease);
---

<SiteLayout title="Get robot2D">
  <section class="page-intro wrap">
    <p class="eyebrow">Get robot2D</p>
    <h1>
      A small engine.
      <br />
      <em>Start exploring.</em>
    </h1>
    <p class="lede">
      Current development is {developmentVersion}. Public downloads start with
      0.8.0; until a release is published, build the dev branch from source.
    </p>
  </section>
  <section class="wrap download-panel">
    <div>
      <span class="pill">Current development</span>
      <h2>{developmentVersion}</h2>
      <p>
        For developers who want to explore the engine and help shape the next
        release.
      </p>
      <div class="actions">
        <a class="button" href={path('docs/getting-started/')}>
          Build from source →
        </a>
        <a class="text-link" href={`${repo}/tree/dev`}>
          Browse dev ↗
        </a>
      </div>
    </div>
    <dl class="facts">
      <div>
        <dt>Development platforms</dt>
        <dd>Windows and Linux source builds</dd>
      </div>
      <div>
        <dt>Graphics</dt>
        <dd>OpenGL 4.5-capable GPU and driver</dd>
      </div>
      <div>
        <dt>Toolchain</dt>
        <dd>C++17 · CMake 3.21+ · Mono / Python 3</dd>
      </div>
      <div>
        <dt>Binary distribution</dt>
        <dd>
          {latest?.assets.length
            ? 'See the published release below.'
            : 'No stable installer is available in the release snapshot.'}
        </dd>
      </div>
    </dl>
  </section>
  <section class="section wrap split">
    <div>
      <p class="eyebrow">Public releases</p>
      <h2>{latest ? latest.tag : '0.8.0 is the next step.'}</h2>
    </div>
    <div>
      {latest ? (
        <>
          <p class="lede">
            {latest.name} · {date(latest.publishedAt)}
          </p>
          <a class="text-link" href={latest.url}>
            Open the published release ↗
          </a>
        </>
      ) : (
        <p class="lede">
          A source checkout is available today. Stable binaries will be listed
          once the first release from 0.8.0 onward is published and checked.
        </p>
      )}
      <div class="actions">
        <a class="text-link" href={path('releases/')}>
          Release status →
        </a>
      </div>
      <p class="fine">
        Snapshot checked {date(snapshot.fetchedAt)}. Prereleases, when
        available, are labelled separately in the catalogue.
      </p>
    </div>
  </section>
</SiteLayout>
