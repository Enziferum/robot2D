---
import SiteLayout from '../layouts/SiteLayout.astro';
import { date, repo, developmentVersion } from '../lib/site';
import { snapshot } from '../lib/releases';
---

<SiteLayout title="Release history">
  <section class="page-intro wrap">
    <p class="eyebrow">Release history</p>
    <h1>
      Every version.
      <br />
      <em>Another step.</em>
    </h1>
    <p class="lede">
      Published releases from GitHub. Current development is{' '}
      {developmentVersion}; it has not been published as a stable release.
    </p>
    <p class="fine">
      Snapshot checked {date(snapshot.fetchedAt)}.{' '}
      <a href={`${repo}/releases`}>See live releases on GitHub ↗</a>
    </p>
  </section>
  <section class="release-list wrap">
    {snapshot.releases.map((release) => (
      <article>
        <div>
          <time datetime={release.publishedAt}>
            {date(release.publishedAt)}
          </time>
          <span class="pill">
            {release.prerelease ? 'Prerelease' : 'Published release'}
          </span>
        </div>
        <div>
          <h2>{release.tag}</h2>
          <p>{release.name}</p>
          <a class="text-link" href={release.url}>
            Read the original release notes ↗
          </a>
          {release.assets.length ? (
            <ul>
              {release.assets.map((asset) => (
                <li>
                  <a href={asset.url}>{asset.name}</a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="fine">Source archives on GitHub · No attached binaries</p>
          )}
        </div>
      </article>
    ))}
  </section>
</SiteLayout>
