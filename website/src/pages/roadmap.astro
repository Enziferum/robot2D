---
import SiteLayout from '../layouts/SiteLayout.astro';
import { repo } from '../lib/site';
const milestones = [
  [
    '0.8.0',
    'Next milestone',
    'Make a small game. Share it.',
    'Bring the scene, scripting, physics and game packaging workflow together. Test it with a playable demo and finish release acceptance.',
    1,
  ],
  [
    '0.9.0',
    'Planned',
    'More room for your worlds.',
    'Develop the runtime architecture, scene transitions, game UI and audio. Scope and implementation are tracked in public issues.',
    2,
  ],
  [
    '1.0.0',
    'Destination',
    'An engine you can rely on.',
    'Stabilise the public tool: compatibility, documentation, distribution and a repeatable path from a fresh install to a first game.',
    3,
  ],
];
---

<SiteLayout title="The road to 1.0">
  <section class="page-intro wrap">
    <p class="eyebrow">The road ahead</p>
    <h1>
      Growing one
      <br />
      <em>milestone at a time.</em>
    </h1>
    <p class="lede">
      These are goals, with public work behind them. Release dates are not set;
      features become release promises after testing and acceptance.
    </p>
  </section>
  <section class="roadmap wrap">
    {milestones.map(([version, label, title, text, number]) => (
      <article>
        <div class="milestone-version">
          {version}
          <span>{label}</span>
        </div>
        <div>
          <h2>{title}</h2>
          <p>{text}</p>
          <a class="text-link" href={`${repo}/milestone/${number}`}>
            Follow this milestone ↗
          </a>
        </div>
      </article>
    ))}
  </section>
  <section class="closing wrap">
    <h2>Follow the work as it happens.</h2>
    <a class="button secondary" href={`${repo}/milestones`}>
      Browse release milestones ↗
    </a>
  </section>
</SiteLayout>
