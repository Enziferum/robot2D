# Include inside nginx's http context (e.g. sites-available/robot2d).
# Replace this example domain and install HTTPS before public launch.
server {
    listen 80;
    server_name robot2d.example.com;
    root /srv/robot2d/current;
    index index.html;

    # HTML, Pagefind manifests and non-hashed public assets must revalidate.
    add_header Cache-Control "no-cache" always;

    location / {
        try_files $uri $uri/ =404;
    }

    # Astro filenames in this directory are content-hashed.
    location /_astro/ {
        root /srv/robot2d/shared;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
